{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "binaryDir": "${sourceDir}/.build/out/${presetName}",
      "installDir": "${sourceDir}/.build/install/${presetName}",
      "generator": "Ninja",
      "hidden": true
    },
    {
      "inherits": "base",
      "name": "win-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe"
      },
      "condition": {
        "lhs": "${hostSystemName}",
        "type": "equals",
        "rhs": "Windows"
      }
    },
    {
      "inherits": "base",
      "name": "linux-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "condition": {
        "lhs": "${hostSystemName}",
        "type": "equals",
        "rhs": "Linux"
      }
    },
    {
      "inherits": "linux-base",
      "name": "android-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Android"
      },
      "condition": {
        "lhs": "${hostSystemName}",
        "type": "equals",
        "rhs": "Android"
      }
    },
    {
      "name": "i686-debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "architecture": {
        "value": "x86",
        "strategy": "external"
      }
    },
    {
      "name": "x64-debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "arm-debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "architecture": {
        "value": "arm",
        "strategy": "external"
      }
    },
    {
      "name": "arm64-debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "architecture": {
        "value": "arm64",
        "strategy": "external"
      }
    },
    {
      "inherits": "i686-debug",
      "name": "i686-release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "inherits": "x64-debug",
      "name": "x64-release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "inherits": "arm-debug",
      "name": "arm-release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "inherits": "arm64-debug",
      "name": "arm64-release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "inherits": [
        "win-base",
        "i686-debug"
      ],
      "name": "win-i686-debug",
      "displayName": "Windows Debug Build (X86 32-bit)",
      "hidden": false
    },
    {
      "inherits": [
        "win-base",
        "x64-debug"
      ],
      "name": "win-x64-debug",
      "displayName": "Windows Debug Build (X86 64-bit)",
      "hidden": false
    },
    {
      "inherits": [
        "win-base",
        "i686-release"
